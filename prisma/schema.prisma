// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum Workspace {
  JOB
  PERSONAL
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  // Set on login/signup, cleared on logout. Whoever holds this token in
  // localStorage is treated as signed in — the whole point of "local
  // storage based" auto-login. One active session at a time is fine for a
  // single-user personal tool.
  sessionToken String? @unique

  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  labels      String[]     @default([])

  // Every task belongs to exactly one account — this is what makes tasks
  // private per user instead of shared across whoever's logged in.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which board this task belongs to. Job and Personal are fully separate
  // boards/archives within a single account.
  workspace Workspace @default(JOB)

  // The specific calendar date this task is assigned to (day-section on the board).
  // Null means the task is in the Backlog — unscheduled, To Do only, not tied
  // to any week until it's dragged onto a day.
  day DateTime? @db.Date

  // Monday of the week `day` falls in. Tasks are grouped/archived by this field
  // so a past week's Done tasks stay put once the current week moves on. Null
  // in lockstep with `day` for backlog tasks.
  weekStart DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, workspace, weekStart, status])
  @@index([userId, day])
}
